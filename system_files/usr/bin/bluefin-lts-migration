#!/usr/bin/env python3
"""Migrate legacy bluefin-lts images to ghcr.io/projectbluefin/."""

import json
import os
import re
import subprocess
import sys

MIGRATED_STAMP = "/etc/bluefin-lts-migrated"
MOTD_DIR = "/run/motd.d"   # tmpfs — auto-clears on reboot, no stale notice on migrated image
MOTD_FILE = f"{MOTD_DIR}/50-bluefin-lts-migration"
TARGET_REGISTRY = "ghcr.io/projectbluefin/"

# Legacy images share repositories across their HWE tags. Only these explicit
# image names may migrate, so a future ublue-os image cannot be switched to an
# inappropriate Bluefin target accidentally.
LEGACY_IMAGE_TARGETS = {
    "bluefin": "bluefin-lts:stable",
    "bluefin-dx": "bluefin-lts:stable",
    "bluefin-gdx": "bluefin-lts-nvidia:stable",
}
ARM64_TARGET = "bluefin-lts:stable"


def write_motd(text: str) -> None:
    os.makedirs(MOTD_DIR, exist_ok=True)
    with open(MOTD_FILE, "w") as f:
        f.write(text + "\n")


def stamp_migrated() -> None:
    open(MIGRATED_STAMP, "w").close()


def get_bootc_status() -> dict:
    result = subprocess.run(
        ["bootc", "status", "--format=json"],
        capture_output=True, text=True, check=True,
    )
    return json.loads(result.stdout)


def current_image_ref(status: dict) -> str:
    try:
        return status["status"]["booted"]["image"]["image"]["image"]
    except (KeyError, TypeError):
        return ""


def resolve_target(image_ref: str, arch: str) -> str | None:
    match = re.search(
        r"ghcr\.io/ublue-os/(bluefin(?:-(?:dx|gdx))?)(?:[:@]|$)", image_ref
    )
    if not match:
        return None

    image_name = match.group(1)
    # No ARM64 Nvidia image exists; migrate GDX ARM64 users to the compatible
    # regular LTS image instead of leaving them on the retired registry.
    if image_name == "bluefin-gdx" and arch in ("aarch64", "arm64"):
        return ARM64_TARGET
    return LEGACY_IMAGE_TARGETS.get(image_name)


# ponytail: clean up legacy systemd overrides to prevent Issue #391 cycles
def cleanup_legacy_systemd() -> None:
    stale = "/etc/systemd/system/default.target.wants/nvmefc-boot-connections.service"
    try:
        if os.path.lexists(stale):
            os.remove(stale)
            print(f"Removed stale systemd unit: {stale}")
    except Exception as e:
        print(f"WARNING: could not remove {stale}: {e}", file=sys.stderr)


def main() -> int:
    if os.path.exists(MIGRATED_STAMP):
        return 0

    try:
        status = get_bootc_status()
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError) as exc:
        print(f"ERROR: could not read bootc status: {exc}", file=sys.stderr)
        return 1

    image_ref = current_image_ref(status)

    if TARGET_REGISTRY in image_ref:
        stamp_migrated()
        return 0

    # Fail closed: only migrate the known legacy Bluefin image repositories.
    target = resolve_target(image_ref, os.uname().machine)
    if target is None:
        print(
            f"WARNING: unrecognized image ref '{image_ref}', skipping migration.",
            file=sys.stderr,
        )
        return 1

    print(f"Migrating from: {image_ref}")

    target_ref = f"{TARGET_REGISTRY}{target}"

    write_motd(
        f"ℹ️  Bluefin LTS: your system is being migrated to {target_ref}.\n"
        "   The migration will complete on your next reboot. Please do not interrupt."
    )
    print(f"Switching to {target_ref} …")

    cleanup_legacy_systemd()

    result = subprocess.run(
        ["bootc", "switch", "--enforce-container-sigpolicy", target_ref],
    )

    if result.returncode == 0:
        stamp_migrated()
        devmode_hint = (
            "\n   💡 Run `ujust devmode` after reboot to restore developer tools."
            if any(k in image_ref for k in ("gdx", "-dx"))
            else ""
        )
        write_motd(
            f"✅  Bluefin LTS migration to {target_ref} complete.\n"
            f"   Please reboot to apply the update.{devmode_hint}"
        )
        print("Migration staged successfully. Reboot to complete.")
        return 0

    print(f"ERROR: bootc switch failed (exit {result.returncode})", file=sys.stderr)
    with open(MOTD_FILE, "a") as f:
        f.write(
            "\n⚠️  Migration attempt failed. It will be retried automatically.\n"
            "   Check `journalctl -u bluefin-lts-migration.service` for details.\n"
        )
    return 1


if __name__ == "__main__":
    sys.exit(main())
